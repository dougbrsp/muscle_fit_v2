{
  "name": "musclefit-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "preview:prod": "next build && node scripts/serve-export.mjs",
    "smoke:export": "node scripts/smoke-export.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "e2e": "node e2e/build.mjs && playwright test --project=chromium-1280 --project=chromium-1440",
    "e2e:webkit": "node e2e/build.mjs && playwright test --project=webkit-1280 --project=webkit-1440",
    "e2e:test": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "build:workout-core": "node scripts/build-workout-core.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
