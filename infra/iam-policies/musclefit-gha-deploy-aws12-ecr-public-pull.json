{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Aws12EcrPublicAuthToken",
      "Effect": "Allow",
      "Action": ["ecr-public:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "Aws12EcrPublicBearerToken",
      "Effect": "Allow",
      "Action": ["sts:GetServiceBearerToken"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sts:AWSServiceName": "ecr-public.amazonaws.com"
        }
      }
    }
  ]
}
