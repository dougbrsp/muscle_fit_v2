{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MusclefitFrontendAssetsBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::musclefit-frontend-assets"
    },
    {
      "Sid": "MusclefitFrontendAssetsObjectReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::musclefit-frontend-assets/*"
    },
    {
      "Sid": "MusclefitFrontendCloudFrontInvalidation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::930413537709:distribution/EOA1PMADLM7RO"
    }
  ]
}
