{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::930413537709:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:dougbrsp/muscle_fit:ref:refs/heads/main",
            "repo:dougbrsp/muscle_fit:pull_request",
            "repo:dougbrsp/muscle_fit:environment:production",
            "repo:dougbrsp@33515327/muscle_fit@1356252176:ref:refs/heads/main",
            "repo:dougbrsp@33515327/muscle_fit@1356252176:pull_request",
            "repo:dougbrsp@33515327/muscle_fit@1356252176:environment:production"
          ]
        }
      }
    }
  ]
}
