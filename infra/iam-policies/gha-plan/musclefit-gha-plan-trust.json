{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GithubOidcSoPullRequest",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::930413537709:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:dougbrsp/muscle_fit_v2:pull_request",
            "repo:dougbrsp@33515327/muscle_fit_v2@1436380326:pull_request"
          ]
        }
      }
    }
  ]
}
