# Ambiente de desenvolvimento LOCAL (Docker Compose + LocalStack).
# Copie para `.env` (`cp .env.example .env`) antes de subir o compose.
# Este arquivo NUNCA conecta em nenhum recurso AWS real - tudo aqui e local.
# Ver docs/local-dev.md para o guia completo.

# -----------------------------------------------------------------------------
# Banco de dados (api/app/db.py, api/app/db_pymysql.py)
# -----------------------------------------------------------------------------
# DB_BACKEND=pymysql usa PyMySQL contra o MySQL local do compose. O default
# em producao (sem esta env var, ou "data-api") usa RDS Data API - NAO altere
# isso fora deste ambiente de dev.
DB_BACKEND=pymysql

# Dentro do docker-compose, o hostname do MySQL e o nome do servico ("mysql").
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=musclefit
MYSQL_PASSWORD=musclefit
# IMPORTANTE: as migrations legadas em api/db/migrations/ (portadas de
# fitness-platform/mysql/init/) fazem `CREATE DATABASE IF NOT EXISTS fitness`
# e `USE fitness;` de forma hardcoded (nao usam a env var MYSQL_DATABASE do
# proprio container mysql:8.0). Para o app apontar para o schema onde as
# tabelas realmente existem, MYSQL_DATABASE PRECISA ser "fitness" - nao troque
# este valor sem tambem revisar as migrations.
MYSQL_DATABASE=fitness
MYSQL_ROOT_PASSWORD=musclefit-root

# -----------------------------------------------------------------------------
# LocalStack (S3, DynamoDB, Secrets Manager) - ver localstack/init/ready.d/
# -----------------------------------------------------------------------------
# Endpoint para chamadas feitas de FORA do compose (ex.: da sua maquina/host,
# scripts locais, AWS CLI no seu terminal). De DENTRO de um container do
# compose (ex.: o servico `api`), use http://localstack:4566 (nome do
# servico), nunca localhost.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=sa-east-1

# -----------------------------------------------------------------------------
# Autenticacao / segredos da API (api/app/security.py, api/app/crypto_utils.py)
# -----------------------------------------------------------------------------
# SEG-19: o valor abaixo e so um exemplo para DEV. Como o DEV e acessado pela rede
# (Tailscale/LAN), troque por segredos ALEATORIOS no seu .env (API_TOKEN, senhas do
# MySQL, SECRET_ENCRYPTION_KEY). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# A API recusa subir com API_TOKEN=dev-local-token quando DB_BACKEND != pymysql.
API_TOKEN=dev-local-token

# Vazio por padrao: sem chave real, os endpoints que chamam a OpenAI (geracao
# de plano de treino, resumo de atividade, cardio agent etc.) retornam a
# mensagem generica de IA indisponivel; o motivo ("OPENAI_API_KEY nao
# configurada") fica so no log, evento `llm.error` - normal em dev sem usar
# essas features.
# Preencha com uma chave real da OpenAI se for testar essas rotas localmente.
OPENAI_API_KEY=

# Chave Fernet valida (base64 urlsafe de 32 bytes) gerada com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fixa aqui apenas para dev local - NUNCA reutilize este valor em staging/producao.
SECRET_ENCRYPTION_KEY=uSg6ooiq4og8Rpuw2yYQs6x6NsuI5YcoyUraTL6XPBc=

# -----------------------------------------------------------------------------
# "Esqueci minha senha" (M5) - api/app/password_reset.py e api/app/captcha.py
# -----------------------------------------------------------------------------
# Remetente do e-mail de redefinicao, enviado via SES (boto3). Em DEV o
# AWS_ENDPOINT_URL acima manda a chamada para o LocalStack, que so aceita
# remetente VERIFICADO: localstack/init/ready.d/00-bootstrap.sh verifica esta
# identidade no boot. O e-mail nao sai de verdade - fica em
# http://localhost:4566/_aws/ses (ver docs/local-dev.md).
PASSWORD_RESET_FROM_EMAIL=no-reply@musclefit.local
# Base da URL que vai no e-mail: ${APP_BASE_URL}/redefinir-senha?token=...
# (o frontend local roda em http://localhost:3000).
APP_BASE_URL=http://localhost:3000
# Cloudflare Turnstile (captcha da solicitacao). Chave SECRETA DE TESTE
# oficial da Cloudflare: sempre aprova, com o MESMO codigo de producao (nao
# existe bypass por env de dev - sem esta variavel a rota responde 503). Em
# producao a Lambda recebe TURNSTILE_SECRET_KEY_SECRET_ARN (Secrets Manager),
# resolvido por api/app/secrets_bootstrap.py.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Site key de TESTE correspondente (publica), lida em build-time pelo Next
# (frontend/src/lib/config.ts). Defina tambem em frontend/.env.local se rodar
# `npm run dev` fora do compose.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------------------------------------
# Nutricao: catalogo USDA FoodData Central (rotas /nutrition/foods/usda/*)
# -----------------------------------------------------------------------------
# Chave pessoal e gratuita do api.data.gov (https://api.data.gov/signup/, a
# mesma que o FDC pede). Vazia = as rotas do catalogo USDA respondem 503 (o
# resto do app segue normal). Em producao a api-core recebe
# USDA_API_KEY_SECRET_ARN (secret `musclefit/usda-api-key`, infra/secrets.tf),
# resolvido por api/app/secrets_bootstrap.py - nao copie a chave para infra/.
USDA_API_KEY=

# -----------------------------------------------------------------------------
# Uploads em S3 (LocalStack) e cards ilustrados de exercicios
# -----------------------------------------------------------------------------
# Os valores de DEV ja vem do docker-compose.yml (bloco `environment` dos
# servicos `api` e `lambda-ai`), que vence este arquivo - NAO e preciso
# copiar nada daqui. As linhas abaixo so documentam os nomes; as marcadas
# "(sobrescrevivel)" aceitam override descomentando a linha neste .env (o
# compose le o .env por interpolacao `${VAR:-default}`).
#
# Mesmos NOMES de producao (infra/lambda_api_core.tf e
# infra/lambda_ai_generators.tf); so os valores de ambiente mudam.
#
# Bucket de uploads (foto de equipamento/academia/perfil, rascunho e card
# publicado). Fixo no compose para `api` e `lambda-ai`:
# EQUIPMENT_PHOTOS_BUCKET=musclefit-uploads
#
# Base da URL publica dos cards publicados. Em producao e a CDN
# (https://app.musclefit.com.br); em DEV, o bucket no LocalStack visto do
# navegador (fixo no compose, segue MUSCLEFIT_LOCALSTACK_HOST_PORT):
# PUBLIC_ASSETS_BASE_URL=http://localhost:4566/musclefit-uploads
#
# SO DEV (nunca em infra/): endpoint usado para ASSINAR a URL pre-assinada do
# rascunho, para o navegador alcancar o LocalStack (de dentro do container o
# S3 e http://localstack:4566, que o navegador nao resolve). Fixo no compose:
# S3_PRESIGN_ENDPOINT_URL=http://localhost:4566
#
# Liga as rotas de geracao de card na api (DEV: true; producao: "false" ate o
# checkpoint de calibracao). Gerar exige OPENAI_API_KEY real acima.
# (sobrescrevivel)
# EXERCISE_CARD_GENERATION_ENABLED=true
# Limites (sobrescreviveis): geracoes por dia (429 ao estourar), geracoes em
# andamento ao mesmo tempo, minutos ate uma geracao travada virar FAILED.
# EXERCISE_CARD_MAX_GENERATIONS_PER_DAY=100
# EXERCISE_CARD_MAX_IN_FLIGHT=2
# EXERCISE_CARD_STALE_MINUTES=10
# OpenAI Images (sobrescreviveis; `api` e `lambda-ai`). O timeout da chamada
# (150 s) fica abaixo do timeout da plan-generator (180 s).
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_SIZE=1024x1536
# OPENAI_IMAGE_TIMEOUT_SECONDS=150

# -----------------------------------------------------------------------------
# CORS / cookie de sessao (api/app/main.py, api/app/security.py) - ajustados
# para o frontend local (`npm run dev`, http://localhost:3000) em vez do
# dominio de producao.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Vazio = sem atributo Domain no cookie (necessario para funcionar em
# localhost/127.0.0.1 - o default de producao ".musclefit.com.br" nao serve
# cookie para localhost).
SESSION_COOKIE_DOMAIN=
# Forca o cookie de sessao sem a flag Secure (dev local roda em http://, sem TLS).
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Seed opcional com dump real de producao (api/scripts/bootstrap_local_db.py)
# -----------------------------------------------------------------------------
# 0 (default) = banco fica vazio (so o schema, via migrations). 1 = aplica o
# restore.sql mais recente de tools/onprem-sync/backups/ - CONTEM DADOS REAIS
# DE PRODUCAO (PII: nomes, e-mails, hashes de senha). So habilite em ambiente
# local confiavel. Ver docs/local-dev.md.
SEED_WITH_PROD_DUMP=0
